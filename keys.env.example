# willnew 클라우드 AI 키 (비교용, 선택)
#
# 이 파일은 git 저장소 밖(~/.willnew)에 있어서 커밋되지 않습니다.
# 값을 비워 두면 그 제공자는 꺼진 것으로 봅니다. 기본은 로컬(Ollama)입니다.
# 나중에 앱 설정 화면이 생기면 같은 값을 OS 키체인에 옮깁니다.

# Anthropic (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) - https://aistudio.google.com/apikey  (선택)
GEMINI_API_KEY=

# 비교에 쓸 모델 이름. 비우면 willnew 가 정한 기본값을 씁니다.
# 각 콘솔의 모델 목록에서 정확한 이름을 복사해 넣으세요.
WILLNEW_ANTHROPIC_MODEL=
WILLNEW_OPENAI_MODEL=
WILLNEW_GEMINI_MODEL=

# 로컬(Ollama). 기본값이면 비워 두세요.
# OLLAMA_HOST=http://127.0.0.1:11434
# WILLNEW_LOCAL_MODEL=
# WILLNEW_LOCAL_EMBED_MODEL=
