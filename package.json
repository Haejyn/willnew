{
  "name": "willnew",
  "version": "0.1.0",
  "description": "채널에 남긴 비개발자 요청을 되묻기와 작업 명세, 구현 제안으로 정리하고, 개발자가 확인하면 에이전트가 격리된 워크트리에서 작업해 테스트로 검증하고, 화면이 바뀌면 요청자가 미리보기로 확인한 뒤 개발자 검토, 병합, 배포까지 잇는 AI 브리지.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "willnew": "dist/server/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/cli.ts serve",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "playwright-core": "1.64.1"
  }
}
